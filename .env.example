# ==================================
# IMPORTANT: DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS!
# ==================================
# Copy this file to .env.local and replace all placeholder values
# with your actual credentials.
#
# Command: cp .env.example .env.local
#
# The .env.local file is already in .gitignore and will not be committed.
# ==================================

# ==================================
# REQUIRED - Supabase Configuration
# ==================================
# Get these from: https://supabase.com/dashboard
# 1. Go to your project Settings → API
# 2. Copy the Project URL and anon/public key

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==================================
# OPTIONAL - Google Maps API
# ==================================
# Required for: Map features, location selection, nearby issues map
# Get your key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API, Geocoding API

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==================================
# OPTIONAL - Gemini AI API
# ==================================
# Required for: AI-powered photo analysis, automatic issue categorization
# Get your key from: https://makersuite.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# ==================================
# OPTIONAL - Razorpay Payment Gateway
# ==================================
# Required for: Crowdfunding features
# Get your keys from: https://razorpay.com/

RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ==================================
# OPTIONAL - VAPI AI Assistant
# ==================================
# Required for: Voice-based issue reporting
# Get your credentials from: https://vapi.ai/

NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# ==================================
# Site Configuration
# ==================================
# For local development, use http://localhost:3000
# For production, use your actual domain

NEXT_PUBLIC_SITE_URL=http://localhost:3000
